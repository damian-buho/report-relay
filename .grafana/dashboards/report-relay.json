    {
      "type": "table",
      "title": "CSP violations",
      "description": "Content Security Policy violations grouped by site, directive and blocked resource: each row is one policy hole or one missing allowance.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (site, directive, blocked, disposition) (count_over_time({service_name=~\"$service\", event_name=\"csp-violation\"} | json site=`attributes[\"report.url_host\"]`, directive=`attributes[\"report.effectiveDirective\"]`, blocked=`attributes[\"report.blockedURL\"]`, disposition=`attributes[\"report.disposition\"]` [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "site": "Site",
              "directive": "Directive",
              "blocked": "Blocked",
              "disposition": "Disposition",
              "Value": "Reports"
            },
            "indexByName": {
              "site": 0,
              "directive": 1,
              "blocked": 2,
              "disposition": 3,
              "Value": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Reports",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Reports"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 12,
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 22
      }
    },
