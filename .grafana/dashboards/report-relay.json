      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true,
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      }
    },
    {
      "type": "bargauge",
      "title": "Accepted by type",
      "description": "Accepted reports per type over the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sort_desc(sum by (report_type) (increase(report_relay_accepted_total{job=~\"$job\"}[$__range])))",
          "editorMode": "code",
          "legendFormat": "{{report_type}}",
          "instant": true,
          "range": false
